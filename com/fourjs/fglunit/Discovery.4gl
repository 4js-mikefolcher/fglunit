PACKAGE com.fourjs.fglunit

# Discovery — the codegen core behind the `fglunit_gen` tool.
#
# Two pure, side-effect-free entry points so the logic can be unit-tested
# with fglunit itself (see tests/test_Discovery.4gl):
#
#   parseSource(src)                 -> DiscoveryResult   (scan -> symbols)
#   renderRunner(module, suite, res) -> STRING            (symbols -> runner)
#
# A "test module" is a plain .4gl (no PACKAGE, no MAIN) containing
# PUBLIC FUNCTION test*() cases plus optional PUBLIC fixtures named
# setUp / tearDown / setUpSuite / tearDownSuite (matched case-insensitively).
#
# The scanner is deliberately a line tokenizer, not a full BDL parser: it
# strips { } block comments and -- / # line comments, then looks for lines
# whose first two whitespace-separated tokens are PUBLIC FUNCTION. This
# handles the common formatting; genuinely ambiguous input fails loudly
# rather than guessing.

PUBLIC TYPE DiscoveryResult RECORD
    tests DYNAMIC ARRAY OF STRING,   # test-case names, in source order
    hasSetup BOOLEAN,
    hasTeardown BOOLEAN,
    hasSetupSuite BOOLEAN,
    hasTeardownSuite BOOLEAN,
    errorMsg STRING                  # non-NULL => discovery failed
END RECORD

# Public API --------------------------------------------------------

# Scan BDL source text and return discovered test cases + fixtures.
# On a duplicate test name or duplicate fixture, errorMsg is set and the
# partial result should be treated as invalid.
PUBLIC FUNCTION parseSource(src STRING) RETURNS DiscoveryResult
    DEFINE res DiscoveryResult
    DEFINE clean STRING
    DEFINE tok base.StringTokenizer
    DEFINE rawLine, name, kind STRING
    DEFINE i INTEGER

    IF src IS NULL THEN
        LET res.errorMsg = "empty source"
        RETURN res
    END IF

    LET clean = stripComments(src)

    LET tok = base.StringTokenizer.create(clean, "\n")
    WHILE tok.hasMoreTokens()
        LET rawLine = tok.nextToken()
        LET name = functionNameOf(rawLine)
        IF name IS NULL THEN CONTINUE WHILE END IF

        LET kind = classify(name)
        CASE kind
            WHEN "test"
                # reject a duplicate test name
                FOR i = 1 TO res.tests.getLength()
                    IF res.tests[i] == name THEN
                        LET res.errorMsg =
                            SFMT("duplicate test function '%1'", name)
                        RETURN res
                    END IF
                END FOR
                LET res.tests[res.tests.getLength() + 1] = name
            WHEN "setUp"
                IF res.hasSetup THEN
                    LET res.errorMsg = "duplicate fixture 'setUp'"
                    RETURN res
                END IF
                LET res.hasSetup = TRUE
            WHEN "tearDown"
                IF res.hasTeardown THEN
                    LET res.errorMsg = "duplicate fixture 'tearDown'"
                    RETURN res
                END IF
                LET res.hasTeardown = TRUE
            WHEN "setUpSuite"
                IF res.hasSetupSuite THEN
                    LET res.errorMsg = "duplicate fixture 'setUpSuite'"
                    RETURN res
                END IF
                LET res.hasSetupSuite = TRUE
            WHEN "tearDownSuite"
                IF res.hasTeardownSuite THEN
                    LET res.errorMsg = "duplicate fixture 'tearDownSuite'"
                    RETURN res
                END IF
                LET res.hasTeardownSuite = TRUE
        END CASE
    END WHILE

    RETURN res
END FUNCTION

# Build the text of a runner module that imports `moduleName` and wires up
# everything parseSource discovered. Caller is responsible for writing it.
PUBLIC FUNCTION renderRunner(moduleName STRING, suiteName STRING,
                             res DiscoveryResult) RETURNS STRING
    DEFINE sb base.StringBuffer
    DEFINE i INTEGER

    LET sb = base.StringBuffer.create()

    CALL line(sb, "-- GENERATED by fglunit-gen -- DO NOT EDIT.")
    CALL line(sb, SFMT("-- source: %1.4gl", moduleName))
    CALL line(sb, "IMPORT FGL com.fourjs.fglunit.FglUnit")
    CALL line(sb, "IMPORT FGL com.fourjs.fglunit.CliArgs")
    CALL line(sb, SFMT("IMPORT FGL %1", moduleName))
    CALL line(sb, "")
    CALL line(sb, "MAIN")
    CALL line(sb, "    CALL CliArgs.parse()")
    CALL line(sb, SFMT("    CALL FglUnit.suite(\"%1\")", suiteName))

    IF res.hasSetupSuite THEN
        CALL line(sb, SFMT("    CALL FglUnit.setSetupSuite(FUNCTION %1.setUpSuite)", moduleName))
    END IF
    IF res.hasTeardownSuite THEN
        CALL line(sb, SFMT("    CALL FglUnit.setTeardownSuite(FUNCTION %1.tearDownSuite)", moduleName))
    END IF
    IF res.hasSetup THEN
        CALL line(sb, SFMT("    CALL FglUnit.setSetup(FUNCTION %1.setUp)", moduleName))
    END IF
    IF res.hasTeardown THEN
        CALL line(sb, SFMT("    CALL FglUnit.setTeardown(FUNCTION %1.tearDown)", moduleName))
    END IF

    FOR i = 1 TO res.tests.getLength()
        CALL line(sb, SFMT("    CALL FglUnit.register(\"%1\", FUNCTION %2.%1)",
            res.tests[i], moduleName))
    END FOR

    CALL line(sb, "    EXIT PROGRAM FglUnit.run()")
    CALL line(sb, "END MAIN")

    RETURN sb.toString()
END FUNCTION

# Derive a suite name from a module/file basename: strip a leading
# "test_" or "test", else return as-is. "test_Calculator" -> "Calculator".
PUBLIC FUNCTION suiteNameFor(moduleName STRING) RETURNS STRING
    DEFINE up STRING
    IF moduleName IS NULL OR moduleName.getLength() == 0 THEN
        RETURN "fglunit"
    END IF
    LET up = moduleName.toUpperCase()
    IF up.getIndexOf("TEST_", 1) == 1 THEN
        RETURN moduleName.subString(6, moduleName.getLength())
    END IF
    IF up.getIndexOf("TEST", 1) == 1 AND moduleName.getLength() > 4 THEN
        RETURN moduleName.subString(5, moduleName.getLength())
    END IF
    RETURN moduleName
END FUNCTION

# Private helpers ---------------------------------------------------

PRIVATE FUNCTION line(sb base.StringBuffer, s STRING)
    CALL sb.append(s)
    CALL sb.append("\n")
END FUNCTION

# Return the declared function name if `rawLine` is a
# `PUBLIC FUNCTION <name> ...` declaration, else NULL.
PRIVATE FUNCTION functionNameOf(rawLine STRING) RETURNS STRING
    DEFINE tok base.StringTokenizer
    DEFINE t1, t2, t3 STRING
    DEFINE paren INTEGER

    IF rawLine IS NULL THEN RETURN NULL END IF
    LET tok = base.StringTokenizer.create(rawLine, " \t")
    IF NOT tok.hasMoreTokens() THEN RETURN NULL END IF
    LET t1 = tok.nextToken()
    IF NOT tok.hasMoreTokens() THEN RETURN NULL END IF
    LET t2 = tok.nextToken()
    IF NOT tok.hasMoreTokens() THEN RETURN NULL END IF
    LET t3 = tok.nextToken()

    IF t1.toUpperCase() != "PUBLIC" THEN RETURN NULL END IF
    IF t2.toUpperCase() != "FUNCTION" THEN RETURN NULL END IF

    # t3 is the name, possibly glued to "(" — e.g. "test_x()" or "test_x"
    LET paren = t3.getIndexOf("(", 1)
    IF paren > 0 THEN
        LET t3 = t3.subString(1, paren - 1)
    END IF
    IF t3.getLength() == 0 THEN RETURN NULL END IF
    RETURN t3
END FUNCTION

# Classify a function name into "test", a fixture name, or "" (ignored).
PRIVATE FUNCTION classify(name STRING) RETURNS STRING
    DEFINE up STRING
    LET up = name.toUpperCase()
    CASE up
        WHEN "SETUP"         RETURN "setUp"
        WHEN "TEARDOWN"      RETURN "tearDown"
        WHEN "SETUPSUITE"    RETURN "setUpSuite"
        WHEN "TEARDOWNSUITE" RETURN "tearDownSuite"
    END CASE
    IF up.getIndexOf("TEST", 1) == 1 THEN
        RETURN "test"
    END IF
    RETURN ""
END FUNCTION

# Remove { } block comments (preserving newlines so line numbers/splitting
# survive) and -- / # line comments. Block comments are not nested in BDL.
PRIVATE FUNCTION stripComments(src STRING) RETURNS STRING
    DEFINE sb base.StringBuffer
    DEFINE i, n INTEGER
    DEFINE c STRING
    DEFINE inBlock BOOLEAN

    LET sb = base.StringBuffer.create()
    LET n = src.getLength()
    LET i = 1
    WHILE i <= n
        LET c = src.subString(i, i)
        IF inBlock THEN
            IF c == "}" THEN
                LET inBlock = FALSE
            ELSE IF c == "\n" THEN
                CALL sb.append("\n")   # keep line structure
            END IF
            END IF
            LET i = i + 1
            CONTINUE WHILE
        END IF
        IF c == "{" THEN
            LET inBlock = TRUE
            LET i = i + 1
            CONTINUE WHILE
        END IF
        # line comments: "--" or "#" run to end of line
        IF c == "#" THEN
            WHILE i <= n AND src.subString(i, i) != "\n"
                LET i = i + 1
            END WHILE
            CONTINUE WHILE
        END IF
        IF c == "-" AND i < n AND src.subString(i + 1, i + 1) == "-" THEN
            WHILE i <= n AND src.subString(i, i) != "\n"
                LET i = i + 1
            END WHILE
            CONTINUE WHILE
        END IF
        CALL sb.append(c)
        LET i = i + 1
    END WHILE
    RETURN sb.toString()
END FUNCTION
