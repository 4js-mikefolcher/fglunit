PACKAGE com.fourjs.fglunit

IMPORT util

# Fuzz -- seeded, reproducible input generators.
#
# Every value comes from one deterministic stream (Park-Miller, written in
# BDL so it does not depend on util.Math and cannot be disturbed by other
# code calling srand). The same seed and size always produce the same
# values on every platform and Genero version, with one exception: strings.
# A multibyte character is generated only where the runtime counts
# characters and not bytes (FGL_LENGTH_SEMANTICS=CHAR in a UTF-8 locale);
# anywhere else it is generated as "?", so that a length limit stays exact.
# The same number of values is drawn either way, so every other value, and
# the length of every string, is the same in every environment.
#
# The seed is scrambled before it starts the stream. Park-Miller is linear:
# started from consecutive seeds, run k + 1 would draw the values of run k
# plus a constant, and a target would see patterned inputs. begin() mixes
# the seed with a nonlinear step so that consecutive seeds, which is what
# the runner uses, give streams that look unrelated.
#
# FglUnit.registerFuzz() calls begin() before each run of a fuzz target and
# reports the seed and size on a failure. A test can also call seed()
# itself and use the generators in an ordinary test.
#
# SIZE is the shrinking knob. At cFullSize the generators range over their
# whole contract. At a smaller size they stay near zero (numbers), near
# 2000-01-01 (dates) and short (strings, counts). After a failure the
# runner re-runs the SAME seed at smaller sizes and keeps the smallest
# size that still fails.
#
# NULL is generated by default (5 percent), because it is the most common
# BDL edge case. Call setNullRate(0) to stop it.
#
# BDL treats an empty string as NULL, so the empty string is covered by
# the NULL rate and is never generated on its own.

PUBLIC CONSTANT cFullSize = 100

PRIVATE CONSTANT cModulus = 2147483647
PRIVATE CONSTANT cMultiplier = 48271
PRIVATE CONSTANT cScrambler = 1597334677
PRIVATE CONSTANT cDefaultNullPercent = 5
PRIVATE CONSTANT cTraceLimit = 400
PRIVATE CONSTANT cLetters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
PRIVATE CONSTANT cPunctuation = " .,;:-_/\\'\"%*?!@#&()[]{}<>=+|~^$"

PRIVATE DEFINE generatorState BIGINT
PRIVATE DEFINE sizeLimit INTEGER
PRIVATE DEFINE nullPercent INTEGER
PRIVATE DEFINE traceText STRING
PRIVATE DEFINE multibyte DYNAMIC ARRAY OF STRING

# Control ------------------------------------------------------------

#+ Start a run: set the seed and the size, and reset the null rate and the
#+ input trace. Returns the seed actually used (any number is folded into
#+ 1 .. 2147483646), which is the value to pass to replay the run.
PUBLIC FUNCTION begin(seedValue BIGINT, newSize INTEGER) RETURNS INTEGER
   VAR folded BIGINT
   IF seedValue IS NULL THEN
      LET seedValue = 1
   END IF
   IF seedValue < 0 THEN
      LET seedValue = -seedValue
   END IF
   # Reduce before adding: seedValue + cModulus - 2 overflows a BIGINT for a
   # seed near 2^63, and the NULL that results would silently restart the
   # generator at seed 1 and full size.
   LET folded = (((seedValue MOD (cModulus - 1)) + cModulus - 2) MOD (cModulus - 1)) + 1
   LET generatorState = scramble(folded)
   LET sizeLimit = NVL(newSize, cFullSize)
   LET nullPercent = cDefaultNullPercent
   LET traceText = NULL
   RETURN folded
END FUNCTION

#+ Seed the generators for use in an ordinary test, at full size.
PUBLIC FUNCTION seed(seedValue BIGINT) RETURNS ()
   VAR used INTEGER
   LET used = begin(seedValue, cFullSize)
END FUNCTION

#+ Percentage (0 to 100) of generated values that are NULL. Default 5.
#+ Reset to the default by begin().
PUBLIC FUNCTION setNullRate(percent INTEGER) RETURNS ()
   CALL ensureStarted()
   LET nullPercent = NVL(percent, 0)
END FUNCTION

PUBLIC FUNCTION getSize() RETURNS INTEGER
   CALL ensureStarted()
   RETURN sizeLimit
END FUNCTION

#+ The values generated since begin(), as text, for failure messages.
PUBLIC FUNCTION getTrace() RETURNS STRING
   RETURN traceText
END FUNCTION

# Generators ---------------------------------------------------------

#+ An INTEGER in lowest .. highest (defaults: the whole INTEGER range),
#+ biased toward the bounds, 0, 1 and -1. May be NULL.
PUBLIC FUNCTION nextInt(lowest INTEGER, highest INTEGER) RETURNS INTEGER
   VAR lo BIGINT
   VAR hi BIGINT
   VAR anchor BIGINT
   VAR value BIGINT
   CALL ensureStarted()
   IF rollNull() THEN
      CALL record("int", NULL)
      RETURN NULL
   END IF
   LET lo = NVL(lowest, -2147483647)
   LET hi = NVL(highest, 2147483647)
   IF lo > hi THEN
      LET value = lo
      LET lo = hi
      LET hi = value
   END IF
   CALL clampBounds(lo, hi) RETURNING lo, hi, anchor
   LET value = pickBig(lo, hi, anchor)
   CALL record("int", value)
   RETURN value
END FUNCTION

#+ A BOOLEAN. May be NULL.
PUBLIC FUNCTION nextBoolean() RETURNS BOOLEAN
   VAR value BOOLEAN
   CALL ensureStarted()
   IF rollNull() THEN
      CALL record("bool", NULL)
      RETURN NULL
   END IF
   LET value = (below(2) = 1)
   CALL record("bool", value)
   RETURN value
END FUNCTION

#+ How many elements to put in a generated array: 0, 1, highest, or a
#+ number between, capped by the size. Never NULL.
PUBLIC FUNCTION nextCount(highest INTEGER) RETURNS INTEGER
   VAR cap INTEGER
   VAR value INTEGER
   CALL ensureStarted()
   LET cap = NVL(highest, 10)
   IF sizeLimit < cFullSize AND cap > sizeLimit THEN
      LET cap = sizeLimit
   END IF
   IF cap <= 0 THEN
      RETURN 0
   END IF
   CASE below(8)
      WHEN 0
         LET value = 0
      WHEN 1
         LET value = 1
      WHEN 2
         LET value = cap
      OTHERWISE
         LET value = below(cap + 1)
   END CASE
   CALL record("count", value)
   RETURN value
END FUNCTION

#+ A string of at most maxLength characters (default 100). Mixes plain
#+ text with the inputs that break code: blanks, quotes, % and *, a
#+ backslash, SQL and markup fragments, control characters, multibyte
#+ UTF-8 and combining characters. May be NULL.
PUBLIC FUNCTION nextString(maxLength INTEGER) RETURNS STRING
   VAR cap INTEGER
   VAR text STRING
   VAR buffer base.StringBuffer
   VAR length INTEGER
   VAR i INTEGER
   CALL ensureStarted()
   IF rollNull() THEN
      CALL record("str", NULL)
      RETURN NULL
   END IF
   LET cap = NVL(maxLength, cFullSize)
   IF sizeLimit < cFullSize AND cap > sizeLimit THEN
      LET cap = sizeLimit
   END IF
   IF cap <= 0 THEN
      CALL record("str", NULL)
      RETURN NULL
   END IF
   IF below(5) = 0 THEN
      LET text = specialString(below(16))
      IF text.getLength() > cap THEN
         LET text = text.subString(1, cap)
      END IF
   ELSE
      IF below(10) = 0 THEN
         LET length = cap
      ELSE
         LET length = 1 + below(cap)
      END IF
      LET buffer = base.StringBuffer.create()
      FOR i = 1 TO length
         CALL buffer.append(randomChar())
      END FOR
      LET text = buffer.toString()
   END IF
   CALL recordText("str", text)
   RETURN text
END FUNCTION

#+ A DATE, biased toward the edges that break date code: 31/12/1899,
#+ 29 February, 31/12/9999 and 1/1/1. Otherwise 1900 to 2099. May be NULL.
PUBLIC FUNCTION nextDate() RETURNS DATE
   VAR value DATE
   VAR offset INTEGER
   CALL ensureStarted()
   IF rollNull() THEN
      CALL record("date", NULL)
      RETURN NULL
   END IF
   IF sizeLimit < cFullSize THEN
      LET offset = below(2 * sizeLimit + 1) - sizeLimit
      LET value = MDY(1, 1, 2000) + offset
   ELSE
      IF below(4) = 0 THEN
         LET value = specialDate(below(10))
      ELSE
         LET offset = below(73050)
         LET value = MDY(1, 1, 1900) + offset
      END IF
   END IF
   CALL record("date", value)
   RETURN value
END FUNCTION

#+ A DECIMAL in lowest .. highest (defaults: plus or minus 1000000000),
#+ biased toward the bounds, 0 and the smallest step. May be NULL.
PUBLIC FUNCTION nextDecimal(lowest DECIMAL(32,10), highest DECIMAL(32,10))
      RETURNS DECIMAL(32,10)
   VAR lo DECIMAL(32,10)
   VAR hi DECIMAL(32,10)
   VAR anchor DECIMAL(32,10) = 0
   VAR value DECIMAL(32,10)
   VAR edges DYNAMIC ARRAY OF DECIMAL(32,10)
   VAR step DECIMAL(32,10) = 0.0000000001
   CALL ensureStarted()
   IF rollNull() THEN
      CALL record("dec", NULL)
      RETURN NULL
   END IF
   LET lo = NVL(lowest, -1000000000)
   LET hi = NVL(highest, 1000000000)
   IF lo > hi THEN
      LET value = lo
      LET lo = hi
      LET hi = value
   END IF
   IF anchor < lo THEN
      LET anchor = lo
   END IF
   IF anchor > hi THEN
      LET anchor = hi
   END IF
   IF sizeLimit < cFullSize THEN
      IF lo < anchor - sizeLimit THEN
         LET lo = anchor - sizeLimit
      END IF
      IF hi > anchor + sizeLimit THEN
         LET hi = anchor + sizeLimit
      END IF
   END IF
   IF below(4) = 0 THEN
      CALL addDecimalEdge(edges, lo, lo, hi)
      CALL addDecimalEdge(edges, hi, lo, hi)
      CALL addDecimalEdge(edges, anchor, lo, hi)
      CALL addDecimalEdge(edges, step, lo, hi)
      CALL addDecimalEdge(edges, -step, lo, hi)
      LET value = edges[below(edges.getLength()) + 1]
   ELSE
      LET value = lo + (hi - lo) * nextRaw() / (cModulus - 1)
   END IF
   CALL record("dec", value)
   RETURN value
END FUNCTION

# Private: stream and bounds -----------------------------------------

PRIVATE FUNCTION ensureStarted() RETURNS ()
   VAR used INTEGER
   # An unset BIGINT is 0, not NULL; 0 is never a valid state, so it means
   # "not started".
   IF generatorState IS NULL OR generatorState = 0 THEN
      LET used = begin(1, cFullSize)
   END IF
END FUNCTION

#+ The state a folded seed starts the stream from: 1 .. cModulus - 1 in,
#+ 1 .. cModulus - 1 out. Multiplying by a constant and raising to the fifth
#+ power modulo the prime cModulus is nonlinear in the seed, and is one to
#+ one because 5 shares no factor with cModulus - 1, so two seeds never
#+ start the same stream. A linear step alone would not do: consecutive
#+ seeds would still give streams that differ by a constant.
PRIVATE FUNCTION scramble(folded BIGINT) RETURNS BIGINT
   VAR product BIGINT
   VAR square BIGINT
   VAR fourth BIGINT
   LET product = (folded * cScrambler) MOD cModulus
   LET square = (product * product) MOD cModulus
   LET fourth = (square * square) MOD cModulus
   RETURN (fourth * product) MOD cModulus
END FUNCTION

PRIVATE FUNCTION nextRaw() RETURNS BIGINT
   CALL ensureStarted()
   LET generatorState = (generatorState * cMultiplier) MOD cModulus
   RETURN generatorState
END FUNCTION

#+ A number in 0 .. n - 1. Two draws are combined when n exceeds one draw.
PRIVATE FUNCTION below(n BIGINT) RETURNS BIGINT
   VAR high BIGINT
   VAR low BIGINT
   IF n <= 1 THEN
      RETURN 0
   END IF
   IF n < cModulus THEN
      RETURN nextRaw() MOD n
   END IF
   LET high = nextRaw()
   LET low = nextRaw()
   RETURN (high * cModulus + low) MOD n
END FUNCTION

PRIVATE FUNCTION rollNull() RETURNS BOOLEAN
   CALL ensureStarted()
   RETURN (nullPercent > 0 AND below(100) < nullPercent)
END FUNCTION

#+ Narrow lo .. hi to the size: around 0, or around the nearest bound when
#+ 0 is outside the range. Returns the new bounds and the anchor.
PRIVATE FUNCTION clampBounds(lo BIGINT, hi BIGINT) RETURNS (BIGINT, BIGINT, BIGINT)
   VAR anchor BIGINT = 0
   IF anchor < lo THEN
      LET anchor = lo
   END IF
   IF anchor > hi THEN
      LET anchor = hi
   END IF
   IF sizeLimit < cFullSize THEN
      IF lo < anchor - sizeLimit THEN
         LET lo = anchor - sizeLimit
      END IF
      IF hi > anchor + sizeLimit THEN
         LET hi = anchor + sizeLimit
      END IF
   END IF
   RETURN lo, hi, anchor
END FUNCTION

PRIVATE FUNCTION pickBig(lo BIGINT, hi BIGINT, anchor BIGINT) RETURNS BIGINT
   VAR edges DYNAMIC ARRAY OF BIGINT
   IF below(4) = 0 THEN
      CALL addEdge(edges, lo, lo, hi)
      CALL addEdge(edges, hi, lo, hi)
      CALL addEdge(edges, anchor, lo, hi)
      CALL addEdge(edges, lo + 1, lo, hi)
      CALL addEdge(edges, hi - 1, lo, hi)
      CALL addEdge(edges, 0, lo, hi)
      CALL addEdge(edges, 1, lo, hi)
      CALL addEdge(edges, -1, lo, hi)
      RETURN edges[below(edges.getLength()) + 1]
   END IF
   RETURN lo + below(hi - lo + 1)
END FUNCTION

PRIVATE FUNCTION addEdge(edges DYNAMIC ARRAY OF BIGINT, candidate BIGINT,
      lo BIGINT, hi BIGINT) RETURNS ()
   IF candidate >= lo AND candidate <= hi THEN
      LET edges[edges.getLength() + 1] = candidate
   END IF
END FUNCTION

PRIVATE FUNCTION addDecimalEdge(edges DYNAMIC ARRAY OF DECIMAL(32,10),
      candidate DECIMAL(32,10), lo DECIMAL(32,10), hi DECIMAL(32,10)) RETURNS ()
   IF candidate >= lo AND candidate <= hi THEN
      LET edges[edges.getLength() + 1] = candidate
   END IF
END FUNCTION

# Private: strings and dates -----------------------------------------

PRIVATE FUNCTION randomChar() RETURNS STRING
   VAR pick INTEGER
   VAR index INTEGER
   LET pick = below(100)
   CASE
      WHEN pick < 60
         LET index = 1 + below(cLetters.getLength())
         RETURN cLetters.subString(index, index)
      WHEN pick < 78
         LET index = 1 + below(cPunctuation.getLength())
         RETURN cPunctuation.subString(index, index)
      WHEN pick < 83
         CASE below(4)
            WHEN 0
               RETURN ASCII 9
            WHEN 1
               RETURN ASCII 10
            WHEN 2
               RETURN ASCII 13
            OTHERWISE
               RETURN ASCII 27
         END CASE
      OTHERWISE
         CALL ensureMultibyte()
         RETURN multibyte[1 + below(multibyte.getLength())]
   END CASE
END FUNCTION

#+ Multibyte UTF-8 characters, written as URL escapes so the source stays
#+ ASCII: e-acute, sharp s, CJK, Arabic, a four-byte emoji and a lone
#+ combining acute accent. Each entry must be exactly one character, or the
#+ length limit of a generated string would not hold. What urlDecode returns
#+ depends on the runtime: with FGL_LENGTH_SEMANTICS=CHAR in a UTF-8 locale
#+ it is one character, with the default (BYTE) semantics the character
#+ has a length of two to four, and in the C locale it is "?". An entry that
#+ is not one character is replaced by "?", which is one in every setting.
PRIVATE FUNCTION ensureMultibyte() RETURNS ()
   VAR i INTEGER
   IF multibyte.getLength() > 0 THEN
      RETURN
   END IF
   LET multibyte[1] = util.Strings.urlDecode("%C3%A9")
   LET multibyte[2] = util.Strings.urlDecode("%C3%9F")
   LET multibyte[3] = util.Strings.urlDecode("%E6%97%A5")
   LET multibyte[4] = util.Strings.urlDecode("%D8%B9")
   LET multibyte[5] = util.Strings.urlDecode("%F0%9F%98%80")
   LET multibyte[6] = util.Strings.urlDecode("%CC%81")
   FOR i = 1 TO multibyte.getLength()
      IF multibyte[i].getLength() != 1 THEN
         LET multibyte[i] = "?"
      END IF
   END FOR
END FUNCTION

PRIVATE FUNCTION specialString(index INTEGER) RETURNS STRING
   VAR mixed STRING
   CASE index
      WHEN 0
         RETURN " "
      WHEN 1
         RETURN "     "
      WHEN 2
         RETURN "'"
      WHEN 3
         RETURN "\""
      WHEN 4
         RETURN "%"
      WHEN 5
         RETURN "*"
      WHEN 6
         RETURN "\\"
      WHEN 7
         RETURN "O'Brien"
      WHEN 8
         RETURN "x'; DROP TABLE t; --"
      WHEN 9
         RETURN "%s%d%1"
      WHEN 10
         RETURN "{\"a\":[1,2,null]}"
      WHEN 11
         RETURN "<a href=\"x\">&amp;</a>"
      WHEN 12
         # A comma list, not ||: ASCII is a prefix operator whose operand
         # runs to the end of the || chain, so "a" || ASCII 9 || "b" ...
         # evaluates to "a ".
         LET mixed = "a", ASCII 9, "b", ASCII 10, "c"
         RETURN mixed
      WHEN 13
         RETURN "  padded  "
      WHEN 14
         CALL ensureMultibyte()
         RETURN multibyte[3] || multibyte[1] || multibyte[5]
      OTHERWISE
         CALL ensureMultibyte()
         RETURN "e" || multibyte[6]
   END CASE
END FUNCTION

PRIVATE FUNCTION specialDate(index INTEGER) RETURNS DATE
   CASE index
      WHEN 0
         RETURN MDY(12, 31, 1899)
      WHEN 1
         RETURN MDY(1, 1, 1900)
      WHEN 2
         RETURN MDY(2, 29, 2000)
      WHEN 3
         RETURN MDY(2, 29, 2024)
      WHEN 4
         RETURN MDY(2, 28, 2023)
      WHEN 5
         RETURN MDY(3, 1, 2023)
      WHEN 6
         RETURN MDY(12, 31, 1999)
      WHEN 7
         RETURN MDY(1, 1, 2000)
      WHEN 8
         RETURN MDY(12, 31, 9999)
      OTHERWISE
         RETURN MDY(1, 1, 1)
   END CASE
END FUNCTION

# Private: trace -----------------------------------------------------

PRIVATE FUNCTION record(kind STRING, value STRING) RETURNS ()
   VAR item STRING
   IF value IS NULL THEN
      LET item = kind || "=NULL"
   ELSE
      LET item = kind || "=" || value
   END IF
   CALL appendTrace(item)
END FUNCTION

PRIVATE FUNCTION recordText(kind STRING, text STRING) RETURNS ()
   VAR shown STRING
   VAR buffer base.StringBuffer
   VAR i INTEGER
   VAR code INTEGER
   LET buffer = base.StringBuffer.create()
   FOR i = 1 TO text.getLength()
      IF i > 60 THEN
         CALL buffer.append("...")
         EXIT FOR
      END IF
      LET code = ord(text.subString(i, i))
      CASE code
         WHEN 9
            CALL buffer.append("\\t")
         WHEN 10
            CALL buffer.append("\\n")
         WHEN 13
            CALL buffer.append("\\r")
         WHEN 27
            CALL buffer.append("\\e")
         OTHERWISE
            IF code < 32 THEN
               CALL buffer.append("?")
            ELSE
               CALL buffer.append(text.subString(i, i))
            END IF
      END CASE
   END FOR
   LET shown = buffer.toString()
   CALL appendTrace(SFMT("%1=\"%2\" (%3 chars)", kind, shown, text.getLength()))
END FUNCTION

PRIVATE FUNCTION appendTrace(item STRING) RETURNS ()
   IF traceText IS NULL THEN
      LET traceText = item
   ELSE
      IF traceText.getLength() < cTraceLimit THEN
         LET traceText = traceText || "; " || item
      ELSE
         IF NOT traceText.getIndexOf("...", cTraceLimit) > 0 THEN
            LET traceText = traceText || "; ..."
         END IF
      END IF
   END IF
END FUNCTION
